# BenchRouter 运行时环境变量
# 复制为 .env 后填入真实值,或 `export` 到 shell。

# === 必需 ===

# OpenAI 兼容 API 基址(vLLM / OpenAI / OpenRouter / 自建代理)
BENCHROUTER_MODEL_ENDPOINT=https://openrouter.ai/api/v1

# API 密钥(OpenRouter 示例:sk-or-v1-...)
OPENAI_API_KEY=sk-or-v1-your-key-here

# 模型名(OpenRouter 需要 provider/ 前缀,如 openai/gpt-4o、anthropic/claude-sonnet-4)
BENCHROUTER_MODEL_NAME=openai/gpt-4o


# === 可选 ===

# BenchRouter 服务端 URL(CLI 连接地址),默认 http://localhost:9000
# BENCHROUTER_SERVER=http://localhost:9000

# BenchRouter 数据目录(benchrouter-server --data-dir),默认 /data/benchrouter
# BENCHROUTER_DATA_DIR=/tmp/benchrouter-data


# === 个别 benchmark 专用(task.yaml 里也能配) ===

# xbench 独立判分模型(默认复用 BENCHROUTER_MODEL_NAME / ENDPOINT)
# XBENCH_JUDGE_MODEL=openai/gpt-4o
# XBENCH_JUDGE_ENDPOINT=https://openrouter.ai/api/v1
# XBENCH_JUDGE_API_KEY=sk-...
# XBENCH_LIMIT=0               # 限制题数,0 = 全量
# XBENCH_N_REPEATS=1

# lmms-eval 相关
# LMMS_EVAL_LIMIT=0            # 限制样本数
# LMMS_EVAL_PRIMARY_METRIC=    # 留空走默认(acc)
# LMMS_EVAL_GEN_KWARGS=max_new_tokens=4096,temperature=0
# ANTHROPIC_COMPAT=0           # 1 时把 image_url 转 Anthropic base64 格式

# browsecomp 相关
# BENCHROUTER_EXAMPLES=0          # 0 = 全量
# BENCHROUTER_GRADER_MODEL=gpt-4.1-2025-04-14

# tau2-bench 相关
# TAU2_NUM_TASKS=              # 留空 = 全量
# TAU2_NUM_TRIALS=1
# TAU2_MAX_STEPS=200
# TAU2_MAX_CONCURRENCY=3
# TAU2_TASK_SPLIT=base
# TAU2_MODEL_PROVIDER=openai
# TAU2_USER_MODEL=             # 用户模拟器模型,默认复用 agent
# TAU2_API_MODE=auto           # auto / openai_compat / bedrock_converse

# webarena 相关
# WEBARENA_TASK_LIMIT=0        # 0 = 全量

# swe-bench-pro 相关
# BENCHROUTER_MAX_TOKENS=8192

# toolathlon 相关(大多数也能从 task.yaml 里读)
# TOOLATHLON_WORKERS=1
# TOOLATHLON_MAXSTEP=100
# TOOLATHLON_TIMEOUT=1800
